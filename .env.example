# Copy this file to ".env" and fill in your real values.
# .env is listed in .gitignore, so it never goes to GitHub.

# --- MySQL connection ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=put_your_mysql_root_password_here
DB_NAME=foodiequery

# --- Groq (free LLM API) ---
GROQ_API_KEY=paste_your_groq_key_here

# --- read-only database account used by the API ---
# Created automatically by: python scripts/create_readonly_user.py
DB_RO_USER=foodiequery_ro
DB_RO_PASSWORD=generated_automatically_do_not_type_by_hand
